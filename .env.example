# Database — local dev uses DATABASE_URL directly, VPS Docker uses POSTGRES_* vars
DATABASE_URL=postgresql://user:password@localhost/artcrm
POSTGRES_USER=artcrm
POSTGRES_PASSWORD=change-me

# AI backends
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=

# Proton Bridge (IMAP + SMTP — must be running locally)
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025
PROTON_EMAIL=your@proton.me
PROTON_PASSWORD=bridge_app_password

# Web UI auth
ADMIN_PASSWORD=change-me
SPECTATOR_PASSWORD=change-me

# Signing secrets — REQUIRED, no default. The app refuses to start if either is unset.
# Generate strong random values: `openssl rand -hex 32`
SESSION_SECRET=change-me-use-random-hex
JWT_SECRET=change-me-use-random-hex

# Server
HOST=127.0.0.1
PORT=8000

# CORS — comma-separated browser origins allowed to call the JSON API.
# Leave empty unless a browser client on another origin must call the API
# (the web UI is same-origin and the mobile app is native, so neither needs this).
CORS_ALLOW_ORIGINS=

# Scout threshold — contacts below this score are dropped. Lower when you want more volume.
SCOUT_THRESHOLD=75
