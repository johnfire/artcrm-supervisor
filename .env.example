# Database — local dev uses DATABASE_URL directly, VPS Docker uses POSTGRES_* vars
DATABASE_URL=postgresql://user:password@localhost/artcrm
POSTGRES_USER=artcrm
POSTGRES_PASSWORD=change-me

# AI backends
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=

# Proton Bridge (IMAP + SMTP — must be running locally)
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025
PROTON_EMAIL=your@proton.me
PROTON_PASSWORD=bridge_app_password

# Web UI auth
ADMIN_PASSWORD=change-me
SPECTATOR_PASSWORD=change-me
SESSION_SECRET=change-me-use-random-hex

# Server
HOST=127.0.0.1
PORT=8000

# Scout threshold — contacts below this score are dropped. Lower when you want more volume.
SCOUT_THRESHOLD=75
